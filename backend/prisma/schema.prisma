generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkloadType {
  CPU_INTENSIVE
  MATRIX_MULTIPLICATION
  SORTING
  DATA_PROCESSING
  SLEEP
}

enum WorkloadPattern {
  LIGHT
  MEDIUM
  HEAVY
  CONSTANT
  BURST
  INCREASING
  DECREASING
  PERIODIC
  CUSTOM
}

enum PlacementStrategy {
  FIRST_FIT
  LEAST_LOADED
  RESOURCE_AWARE
}

enum SchedulingPolicy {
  FCFS
  SJF
  PRIORITY
  ROUND_ROBIN
}

enum JobStatus {
  CREATED
  QUEUED
  WAITING
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  INTERRUPTED
  CANCELLED
}

enum WorkerStatus {
  STARTING
  ACTIVE
  IDLE
  BUSY
  STOPPING
  FAILED
  /// Removed from service by the autoscaler; kept so job history still resolves.
  RETIRED
}

enum ScalingAction {
  SCALE_UP
  SCALE_DOWN
}

/// How the autoscaler reads load: measured now, or predicted ahead.
enum ScalingStrategy {
  REACTIVE
  ML
}

enum BenchmarkStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ABORTED
}

enum AllocationStatus {
  RESERVED
  RELEASED
  ROLLED_BACK
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  INTERRUPTED
  CANCELLED
  /// Evicted when its Round Robin quantum expired; the job went back to the queue.
  PREEMPTED
}

model WorkloadBatch {
  id               String            @id @default(uuid()) @db.Char(36)
  seed             Int
  jobCount         Int
  pattern          WorkloadPattern
  generatorVersion String            @db.VarChar(16)
  parameters       Json
  startsAt         DateTime
  sourceBatchId    String?           @db.Char(36)
  createdAt        DateTime          @default(now())
  sourceBatch      WorkloadBatch?    @relation("BatchReuse", fields: [sourceBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reusedBatches    WorkloadBatch[]   @relation("BatchReuse")
  jobs             Job[]
  benchmarkRuns    BenchmarkRun[]
  scalingComparisonRuns ScalingComparisonRun[]

  @@index([sourceBatchId])
  @@index([createdAt])
  @@map("workload_batches")
}

model Job {
  id                       String             @id @default(uuid()) @db.Char(36)
  name                     String             @db.VarChar(100)
  workloadType             WorkloadType
  workloadSize             Int                @default(1)
  status                   JobStatus          @default(QUEUED)
  cpuRequiredMillicores    Int
  memoryRequiredMiB        Int
  estimatedDurationSeconds Int
  priority                 Int                @default(5)
  workloadBatchId          String?            @db.Char(36)
  batchSequence            Int?
  arrivalOffsetSeconds     Int                @default(0)
  arrivalAt                DateTime           @default(now())
  schedulingPolicy         SchedulingPolicy?
  scheduledAt              DateTime?
  timeQuantumSeconds       Int?
  schedulingRounds         Int                @default(0)
  /// Times a Round Robin quantum expiry evicted this job back to the queue.
  preemptionCount          Int                @default(0)
  /// Times this job was requeued after a failed or interrupted execution.
  retryCount               Int                @default(0)
  placementStrategy        PlacementStrategy?
  placedAt                 DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  startedAt                DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  assignedWorkerId         String?            @db.Char(36)
  containerId              String?            @unique @db.VarChar(128)
  result                   Json?
  failureReason            String? @db.Text
  workloadBatch            WorkloadBatch?     @relation(fields: [workloadBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedWorker           Worker?            @relation("AssignedJobs", fields: [assignedWorkerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocations              ResourceAllocation[]
  executions               JobExecution[]

  @@unique([workloadBatchId, batchSequence])
  @@index([status, arrivalAt, createdAt, batchSequence, id])
  @@index([status, estimatedDurationSeconds, arrivalAt, id])
  @@index([status, priority, arrivalAt, id])
  @@index([status, schedulingRounds, arrivalAt, id])
  @@index([workloadBatchId])
  @@index([assignedWorkerId])
  @@index([assignedWorkerId, status])
  @@map("jobs")
}

model Worker {
  id                      String               @id @default(uuid()) @db.Char(36)
  name                    String               @unique @db.VarChar(64)
  cpuCapacityMillicores   Int
  memoryCapacityMiB       Int
  cpuAllocatedMillicores  Int                  @default(0)
  memoryAllocatedMiB      Int                  @default(0)
  status                  WorkerStatus         @default(IDLE)
  /// Created by the autoscaler, which is the only thing allowed to retire it.
  autoscaled              Boolean              @default(false)
  lastHeartbeat           DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  assignedJobs            Job[]                @relation("AssignedJobs")
  allocations             ResourceAllocation[]
  executions              JobExecution[]
  samples                 WorkerSample[]
  scalingEvents           ScalingEvent[]

  @@index([status])
  @@index([autoscaled, status])
  @@map("workers")
}

/// One multi-policy benchmark: the same seeded workload run once per policy.
model BenchmarkSuite {
  id                 String            @id @default(uuid()) @db.Char(36)
  status             BenchmarkStatus   @default(RUNNING)
  placementStrategy  PlacementStrategy
  /// Arrival pattern as requested, including IMMEDIATE.
  pattern            String            @db.VarChar(16)
  seed               Int
  jobCount           Int
  workloadTypes      Json
  /// Used only by the Round Robin run.
  timeQuantumSeconds Int
  jobsPerTick        Int
  failureReason      String?           @db.Text
  startedAt          DateTime          @default(now())
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  runs               BenchmarkRun[]

  @@index([createdAt])
  @@index([status])
  @@map("benchmark_suites")
}

/// One policy's run inside a suite. Metrics are copied in when the run ends,
/// so the comparison survives clearing the jobs it measured.
model BenchmarkRun {
  id                    String           @id @default(uuid()) @db.Char(36)
  suiteId               String           @db.Char(36)
  position              Int
  policy                SchedulingPolicy
  status                BenchmarkStatus  @default(PENDING)
  workloadBatchId       String?          @db.Char(36)
  startedAt             DateTime?
  completedAt           DateTime?
  failureReason         String?          @db.Text
  /// Cluster capacity when the run started, so fairness can be checked.
  workerCount           Int?
  cpuCapacityMillicores Int?
  memoryCapacityMiB     Int?
  jobCount              Int              @default(0)
  completedJobs         Int              @default(0)
  failedJobs            Int              @default(0)
  cancelledJobs         Int              @default(0)
  preemptions           Int              @default(0)
  retries               Int              @default(0)
  avgWaitSeconds        Float?
  p95WaitSeconds        Float?
  avgTurnaroundSeconds  Float?
  p95TurnaroundSeconds  Float?
  avgResponseSeconds    Float?
  p95ResponseSeconds    Float?
  makespanSeconds       Float?
  throughputPerMinute   Float?
  /// Digest of every completed job's result checksum, to prove identical work.
  checksumDigest        String?          @db.VarChar(64)
  createdAt             DateTime         @default(now())
  suite                 BenchmarkSuite   @relation(fields: [suiteId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  workloadBatch         WorkloadBatch?   @relation(fields: [workloadBatchId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([suiteId, position])
  @@unique([suiteId, policy])
  @@index([workloadBatchId])
  @@map("benchmark_runs")
}

/// One autoscaler decision that changed the cluster, with the signals behind it.
model ScalingEvent {
  id                String        @id @default(uuid()) @db.Char(36)
  action            ScalingAction
  workerId          String        @db.Char(36)
  workerName        String        @db.VarChar(64)
  reason            String        @db.Text
  queuedJobs        Int
  cpuUtilization    Float
  memoryUtilization Float
  /// Schedulable workers after the action.
  workerCount       Int
  createdAt         DateTime      @default(now())
  worker            Worker        @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([createdAt])
  @@index([workerId])
  @@map("scaling_events")
}

/// One Reactive-vs-ML comparison: the same seeded workload run once per
/// autoscaling strategy, with every other setting held fixed.
model ScalingComparison {
  id                 String                 @id @default(uuid()) @db.Char(36)
  status             BenchmarkStatus        @default(RUNNING)
  schedulingPolicy   SchedulingPolicy
  placementStrategy  PlacementStrategy
  /// Arrival pattern as requested, including IMMEDIATE.
  pattern            String                 @db.VarChar(16)
  seed               Int
  jobCount           Int
  workloadTypes      Json
  timeQuantumSeconds Int
  jobsPerTick        Int
  /// Autoscaler thresholds and limits that both runs used.
  autoscalerSettings Json
  failureReason      String?                @db.Text
  startedAt          DateTime               @default(now())
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  runs               ScalingComparisonRun[]

  @@index([createdAt])
  @@index([status])
  @@map("scaling_comparisons")
}

/// One strategy's run inside a comparison. Results are copied in when the run
/// ends, so they survive clearing the jobs they measured.
model ScalingComparisonRun {
  id                     String                    @id @default(uuid()) @db.Char(36)
  comparisonId           String                    @db.Char(36)
  position               Int
  strategy               ScalingStrategy
  status                 BenchmarkStatus           @default(PENDING)
  workloadBatchId        String?                   @db.Char(36)
  startedAt              DateTime?
  completedAt            DateTime?
  failureReason          String?                   @db.Text
  /// Base cluster when the run started, so fairness can be checked.
  workerCount            Int?
  cpuCapacityMillicores  Int?
  memoryCapacityMiB      Int?
  jobCount               Int                       @default(0)
  completedJobs          Int                       @default(0)
  failedJobs             Int                       @default(0)
  cancelledJobs          Int                       @default(0)
  avgWaitSeconds         Float?
  p95WaitSeconds         Float?
  avgTurnaroundSeconds   Float?
  makespanSeconds        Float?
  throughputPerMinute    Float?
  /// Digest of every completed job's result checksum, to prove identical work.
  checksumDigest         String?                   @db.VarChar(64)
  /// First moment the cluster was under scale-up pressure.
  pressureAt             DateTime?
  firstScaleUpAt         DateTime?
  /// firstScaleUpAt minus pressureAt; negative means it scaled up early.
  reactionSeconds        Float?
  /// Time at least the scale-up threshold of jobs were waiting.
  backedUpSeconds        Float?
  /// Autoscaled workers in service, integrated over the run.
  extraWorkerSeconds     Float?
  /// The part of extraWorkerSeconds when those workers held nothing.
  idleExtraWorkerSeconds Float?
  peakWorkers            Int?
  scaleUps               Int                       @default(0)
  scaleDowns             Int                       @default(0)
  /// Workers added back within 60 seconds of a retirement.
  flaps                  Int                       @default(0)
  /// Mean absolute error, in jobs, of the ML queue forecast (ML runs only).
  forecastMeanAbsError   Float?
  forecastPairs          Int                       @default(0)
  /// Scaling actions during the run, copied from scaling_events.
  scalingActions         Json?
  createdAt              DateTime                  @default(now())
  comparison             ScalingComparison         @relation(fields: [comparisonId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  workloadBatch          WorkloadBatch?            @relation(fields: [workloadBatchId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  samples                ScalingComparisonSample[]

  @@unique([comparisonId, position])
  @@unique([comparisonId, strategy])
  @@index([workloadBatchId])
  @@map("scaling_comparison_runs")
}

/// One timeline point of a comparison run: load, workers, and the forecast.
model ScalingComparisonSample {
  id                 String               @id @default(uuid()) @db.Char(36)
  runId              String               @db.Char(36)
  at                 DateTime
  /// Seconds since the run started, so the two runs share one time axis.
  offsetSeconds      Float
  queuedJobs         Int
  workersInService   Int
  extraWorkers       Int
  idleExtraWorkers   Int
  peakUtilization    Float
  /// What the ML strategy predicted at this moment, for its look-ahead.
  forecastQueuedJobs Float?
  forecastPeak       Float?
  run                ScalingComparisonRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([runId, offsetSeconds])
  @@map("scaling_comparison_samples")
}


model WorkerSample {
  id                     String       @id @default(uuid()) @db.Char(36)
  workerId               String       @db.Char(36)
  /// Every worker written by one sampling pass shares this timestamp.
  capturedAt             DateTime
  cpuCapacityMillicores  Int
  memoryCapacityMiB      Int
  cpuAllocatedMillicores Int
  memoryAllocatedMiB     Int
  status                 WorkerStatus
  runningExecutions      Int          @default(0)
  reservedAllocations    Int          @default(0)
  createdAt              DateTime     @default(now())
  // Samples are observational, not authoritative, so they follow the worker.
  worker                 Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([workerId, capturedAt])
  @@index([capturedAt])
  @@map("worker_samples")
}

model ResourceAllocation {
  id              String           @id @default(uuid()) @db.Char(36)
  jobId           String           @db.Char(36)
  workerId        String           @db.Char(36)
  cpuMillicores   Int
  memoryMiB       Int
  status          AllocationStatus @default(RESERVED)
  reservedAt      DateTime         @default(now())
  releasedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  job             Job              @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  worker          Worker           @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  execution       JobExecution?

  // Supports a composite execution foreign key that guarantees job/worker identity.
  @@unique([id, jobId, workerId])
  @@index([jobId, status])
  @@index([workerId, status])
  @@map("resource_allocations")
}

model JobExecution {
  id            String             @id @default(uuid()) @db.Char(36)
  jobId         String             @db.Char(36)
  workerId      String             @db.Char(36)
  allocationId  String             @unique @db.Char(36)
  attempt       Int
  status        ExecutionStatus    @default(PENDING)
  containerId   String?            @unique @db.VarChar(128)
  startedAt     DateTime?
  completedAt   DateTime?
  exitCode      Int?
  stdout        String? @db.MediumText
  stderr        String? @db.MediumText
  failureReason String? @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  job           Job                @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  worker        Worker             @relation(fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocation    ResourceAllocation @relation(fields: [allocationId, jobId, workerId], references: [id, jobId, workerId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([jobId, attempt])
  @@unique([allocationId, jobId, workerId])
  @@index([jobId])
  @@index([workerId])
  @@index([status, createdAt])
  @@map("job_executions")
}
