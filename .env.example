# Local PostgreSQL container configuration
POSTGRES_USER=orchestr_os
POSTGRES_PASSWORD=orchestr_os
POSTGRES_DB=orchestr_os
POSTGRES_PORT=5432

# Backend configuration for direct local development
DATABASE_URL=postgresql://orchestr_os:orchestr_os@localhost:5432/orchestr_os?schema=public
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Container-internal URL. Percent-encode reserved characters in credentials.
DATABASE_URL_DOCKER=postgresql://orchestr_os:orchestr_os@postgres:5432/orchestr_os?schema=public

# Published frontend port
FRONTEND_PORT=5173

# Controlled workload execution.
# Leave DOCKER_SOCKET_PATH unset: it defaults to //./pipe/docker_engine on
# Windows and /var/run/docker.sock elsewhere, which is correct both on the host
# and inside the backend container. Running workload containers requires access
# to that socket, which is a host-level privilege; see docs/decision.md.
# DOCKER_SOCKET_PATH=
EXECUTION_TIMEOUT_SECONDS=300
EXECUTION_LOG_LIMIT_BYTES=8192
